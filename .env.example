# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- required ---
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- general ---
DJANGO_DEBUG=0              # 1 only for local development (enables SQLite fallback and a throw-away secret key)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api
FRONTEND_URL=http://localhost:3000
NUM_PROXIES=1               # trusted reverse proxies in front of Django (Next.js = 1; add your load balancer)
SIGNUPS_OPEN=0               # 1 = anyone can create a club and start the free trial (match NEXT_PUBLIC_SIGNUPS_OPEN in the frontend)
CONTACT_EMAIL=              # receives "contact us" messages by e-mail (they are always stored; see the admin) 
TRIAL_DAYS=14
MAX_SEATS=5

# --- database (Docker Compose sets POSTGRES_HOST for you) ---
POSTGRES_DB=footballclub
POSTGRES_USER=footballclub
POSTGRES_SSLMODE=prefer     # "require" for managed databases (Cloud SQL, RDS, Azure, Neon, Supabase)

# --- uploads: local | s3 | gcs | azure   (see web_application/storage.py) ---
MEDIA_STORAGE=local
MEDIA_PUBLIC=1              # 0 = private bucket with signed URLs
# s3:    AWS_STORAGE_BUCKET_NAME=  AWS_S3_REGION_NAME=  AWS_S3_ENDPOINT_URL= (R2/MinIO/Spaces)
# gcs:   GS_BUCKET_NAME=
# azure: AZURE_ACCOUNT_NAME=  AZURE_CONTAINER=   (+ AZURE_ACCOUNT_KEY or AZURE_CONNECTION_STRING if no managed identity)
# Prefer the platform identity (IAM role / service account / managed identity) over static keys.

# --- demo data (development only) ---
SEED_DEMO_DATA=0
SEED_ADMIN_PASSWORD=        # empty = a random password is generated and printed once

# --- billing and email (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
